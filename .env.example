# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
#
# Only extensions that talk to an external service read anything here. Core
# CritterFrame needs none of it -- a project is a directory path passed to each
# function, so there is no DATA_DIR and no global configuration. Credentials
# stay in the environment rather than in a project precisely because a project
# directory gets copied, archived, and shared.

# --- extensions/antenna_lighttraps -----------------------------------------
ANTENNA_EMAIL=
ANTENNA_PW=

# Antenna project to export from (Moth Monitoring 2.0 = 199).
ANTENNA_PROJECT_ID=199

# Optional; defaults to https://api.antenna.insectai.org/api/v2
ANTENNA_BASE=

# Nothing else. The scale step reads sheet images from Antenna's captures
# endpoint, which hands back presigned urls, so the credentials above cover both
# the occurrence export and the images -- there is no cloud account to arrange.

# --- extensions/inat_insects ------------------------------------------------
# None. The iNaturalist observation search is public and unauthenticated.
